APP_ENV=development

# Security: generate each production value independently, e.g.
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# APP_ENV=production requires SECRET_KEY and MEDIA_SIGNING_KEY to be distinct and
# validates PROVIDER_KEY_ENCRYPTION_KEY; missing/known-default values block startup.
# PROVIDER_KEY_ENCRYPTION_KEY format: v1:<Fernet key>, generate the key with:
# python3 -c "from cryptography.fernet import Fernet; print('v1:' + Fernet.generate_key().decode())"
SECRET_KEY=
MEDIA_SIGNING_KEY=
PROVIDER_KEY_ENCRYPTION_KEY=
MCP_TOKEN=
DEFAULT_LOCALE=zh-CN

# Bootstrap admin
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=

# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:<POSTGRES_PASSWORD>@localhost:5432/home_monitor

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
VIDEO_ROOT_PATH=/data/videos
PLAYBACK_CACHE_ROOT=/data/hls
ENTITY_IMAGE_ROOT=/data/images

# Session playback
SESSION_PLAYBACK_MODE=hls_index_only

# Analysis
# Session analysis sends exactly one video file per LLM call; there are no
# chunk/sub-chunk sizing knobs (removed with the two-level chunking scheme).

# DB bootstrap retry
DB_INIT_MAX_RETRIES=120
DB_INIT_RETRY_INTERVAL_SECONDS=2
