APP_ENV=development

# Security: generate each production value independently, e.g.
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# APP_ENV=production requires SECRET_KEY and MEDIA_SIGNING_KEY to be distinct.
# PROVIDER_KEY_ENCRYPTION_KEY format: v1:<Fernet key>, generate the key with:
# python3 -c "from cryptography.fernet import Fernet; print('v1:' + Fernet.generate_key().decode())"
SECRET_KEY=
MEDIA_SIGNING_KEY=
PROVIDER_KEY_ENCRYPTION_KEY=
MCP_TOKEN=
DEFAULT_LOCALE=zh-CN

# Bootstrap admin
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=

# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:<POSTGRES_PASSWORD>@localhost:5432/home_monitor

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
VIDEO_ROOT_PATH=/data/videos
PLAYBACK_CACHE_ROOT=/data/hls
ENTITY_IMAGE_ROOT=/data/images

# Session playback
SESSION_PLAYBACK_MODE=hls_index_only

# Analysis
ANALYZER_SEGMENT_SECONDS=600
# Per-call LLM sub-chunk size (seconds). Each session chunk is subdivided
# into <= this size sub-chunks and submitted to the vision model as one
# call. Must be <= ANALYZER_SEGMENT_SECONDS. 60s pairs with N=120 at 2fps
# (100M budget → 1216×672 per frame ≈ 88.7% of 720p).
ANALYZER_LLM_CHUNK_SECONDS=60
# Client-side keyframe extraction tuning (REPORT §4.1).
ANALYZER_VIDEO_KEYFRAME_PERIOD_SECONDS=8
ANALYZER_VIDEO_KEYFRAME_MAD_THRESHOLD=1.0
ANALYZER_VIDEO_KEYFRAME_PHASH_THRESHOLD=6
# When true, keyframe extraction failure falls back to the legacy
# data:video/mp4 path so analysis is not blocked.
ANALYZER_VIDEO_KEYFRAME_FALLBACK_TO_MP4=true

# DB bootstrap retry
DB_INIT_MAX_RETRIES=120
DB_INIT_RETRY_INTERVAL_SECONDS=2
